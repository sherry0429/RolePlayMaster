{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RolePlayMaster",
  "version": "1.0.0",
  "identifier": "top.poecurrency.roleplaymaster",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "RolePlayMaster",
        "width": 390,
        "height": 360,
        "minWidth": 240,
        "minHeight": 300,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "shadow": false,
        "focus": true,
        "visible": true,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Entertainment",
    "shortDescription": "角色扮演 AI 桌面化身",
    "longDescription": "RolePlayMaster 桌面版：以角色化身气泡的形式与本机 AI 聊天，支持群聊、动态 System Prompt、记忆压缩与 AI 拍照。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
